# Shared Supabase project for the private Gym flow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public origin and auth mode for the private Gym app.
NEXT_PUBLIC_GYM_TRACKER_ORIGIN=https://gym.w3yh.xyz
NEXT_PUBLIC_GYM_TRACKER_REQUIRE_AUTH=true
NEXT_PUBLIC_W3YH_PRIVATE_GATE_ORIGIN=https://private.w3yh.xyz

# Optional direct-login allowlist while the private gate is still rolling out.
GYM_ALLOWED_EMAILS=dominik@example.com

# Server-only: Secret-/Service-Role-Key des geteilten Supabase-Projekts.
SUPABASE_SECRET_KEY=sb_secret_replace-me

# Server-only: muss dem Gym-Audience-Secret im Private Gate entsprechen.
W3YH_PRIVATE_HANDOFF_GYM_REDEEM_SECRET=replace-with-at-least-32-random-characters
